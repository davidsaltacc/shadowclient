{
	"schemaVersion": 1,
	"id": "shadowclient",
	"version": "${version}",
	"name": "ShadowClient",
	"description": "utility and cheat thing for block game",
	"authors": [
		"justacoder"
	],
	"license": "MIT License",
	"icon": "assets/shadowclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.justacoder.shadowclient.fabric.FabricInitializer"
		]
	},
	"mixins": [
		{
			"config": "shadowclient.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener" : "shadowclient.accesswidener",
	"depends": {
		"fabricloader": ">=0.16",
		"minecraft": "~1.21.4",
		"java": ">=21"
	},
	"breaks": {
		"wurst": "*",
		"meteor-client": "*"
	}
}